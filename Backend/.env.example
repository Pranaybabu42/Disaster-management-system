APP_NAME=Disaster Management System API
ENVIRONMENT=development
MONGO_URI=mongodb://localhost:27017/DMS
MONGO_DATABASE=DMS
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_SIGNING_KEY_ID=primary
# During rollover, retain previous keys here as comma-separated kid=secret pairs until their tokens expire.
JWT_PREVIOUS_SIGNING_KEYS=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_PARALLELISM=2
PASSWORD_HASH_SALT_LENGTH=16
PASSWORD_HASH_LENGTH=32
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW_SECONDS=3600
RECOVERY_RATE_LIMIT=3
RECOVERY_RATE_WINDOW_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
REFRESH_COOKIE_NAME=dms_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_STARTTLS=true
PASSWORD_RESET_URL=http://localhost:5173/reset-password
